# ==========================================
# Atlassian Data Center
# ==========================================
COMPOSE_PROJECT_NAME=atlassian
TZ=America/Chicago

# ==========================================
# Image Versions
# Select supported, tested release tags
# ==========================================
POSTGRES_VERSION=17
HAPROXY_VERSION=3.4-alpine

JIRA_VERSION=11.3
CONFLUENCE_VERSION=11.0
BITBUCKET_VERSION=10.5

# ==========================================
# Public Domains
# ==========================================
JIRA_DOMAIN=jira.example.com
CONFLUENCE_DOMAIN=confluence.example.com
BITBUCKET_DOMAIN=bitbucket.example.com

# ==========================================
# PostgreSQL Administrator
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ==========================================
# Jira Software / JSM
# ==========================================
JIRA_DB=jira
JIRA_DB_USER=jira
JIRA_DB_PASSWORD=

JIRA_MIN_HEAP=2g
JIRA_MAX_HEAP=4g

# ==========================================
# Confluence
# ==========================================
CONFLUENCE_DB=confluence
CONFLUENCE_DB_USER=confluence
CONFLUENCE_DB_PASSWORD=

CONFLUENCE_CLUSTER_NAME=confluence-dc
CONFLUENCE_MIN_HEAP=2g
CONFLUENCE_MAX_HEAP=4g

# ==========================================
# Bitbucket
# ==========================================
BITBUCKET_DB=bitbucket
BITBUCKET_DB_USER=bitbucket
BITBUCKET_DB_PASSWORD=

BITBUCKET_CLUSTER_NAME=bitbucket-dc
BITBUCKET_CLUSTER_PASSWORD=

# ==========================================
# Host Ports
# ==========================================
HAPROXY_HTTP_PORT=8088
BITBUCKET_SSH_PORT=7999